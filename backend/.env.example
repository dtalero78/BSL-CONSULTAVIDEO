# Server Configuration
PORT=3000
NODE_ENV=development

# Twilio Video Credentials (for video calls)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio API Key (required for Twilio Video)
TWILIO_API_KEY_SID=your_api_key_sid_here
TWILIO_API_KEY_SECRET=your_api_key_secret_here

# Twilio Voice Credentials (for phone calls)
TWILIO_VOICE_ACCOUNT_SID=your_voice_account_sid_here
TWILIO_VOICE_AUTH_TOKEN=your_voice_auth_token_here

# WhatsApp API (WHAPI) - Required for session reports
WHAPI_TOKEN=your_whapi_token_here

# JWT Secret for application authentication
JWT_SECRET=your_jwt_secret_here

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database (Digital Ocean) - Para backup y consultas rápidas
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=your_postgres_host_here
POSTGRES_PORT=25060
POSTGRES_DATABASE=defaultdb

# Integración Maluwa360 (POST /api/integration/consultas + webhook de resultado)
# Clave que Maluwa360 envía en el header X-Integration-Key. Mínimo 32 caracteres
# (generar con: openssl rand -hex 32). Sin ella el endpoint responde 503 (falla cerrado).
MALUWA360_API_KEY=
# Tenant con el que se crean las historias clínicas (el mismo del panel del médico). Default: bsl
MALUWA360_TENANT_ID=bsl
# Webhook de resultado hacia Maluwa360. Header X-Signature = hex(HMAC-SHA256(secreto, body crudo)).
# Con URL y secreto arranca el worker (cada 30s): detecta historias atendidas por CUALQUIER backend
# que comparta la BD (hoy el médico guarda en aws.medico-bsl.com) y reintenta envíos fallidos.
# Sin ellas el worker no arranca; al configurarlas, el detector toma los resultados de los últimos 30 días.
MALUWA360_WEBHOOK_URL=https://360.maluwa.app/api/integraciones/bsl/resultado
MALUWA360_WEBHOOK_SECRET=
# Variables existentes que también usa la integración:
#   APP_URL=https://medico-bsl.com                  → base de patientUrl / doctorUrl
#   TWILIO_TEMPLATE_VIDEOCONSULTA_SUELTA=HX...       → plantilla del WhatsApp cuando notificar=true
